# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/entropy_youtube?schema=public"

# NextAuth / Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-random-key"

# Tigris Globally Distributed Object Storage (Primary Storage Provider)
# Tigris is S3-compatible, ultra-low latency, and has zero egress fees.
# Endpoint defaults to https://fly.storage.tigris.dev
TIGRIS_ACCESS_KEY_ID=""
TIGRIS_SECRET_ACCESS_KEY=""
TIGRIS_BUCKET="entropy-videos"
TIGRIS_ENDPOINT="https://fly.storage.tigris.dev"
TIGRIS_REGION="auto"
TIGRIS_PUBLIC_URL=""

# Vercel Blob Storage (Fallback)
# Automatically added when you click "Storage > Connect Blob" in Vercel dashboard:
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# Cloudflare R2 / S3 Object Storage
# To use Cloudflare R2, populate your account ID, API credentials, and bucket:
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="entropy-videos"
CLOUDFLARE_R2_PUBLIC_URL=""

# S3 / Object Storage fallback (MinIO or AWS S3)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="youtube-media"
S3_REGION="auto"
S3_PUBLIC_DOMAIN="http://localhost:9000/youtube-media"

# Redis (for background queue & view buffering)
REDIS_URL="redis://localhost:6379"
